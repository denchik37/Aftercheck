{
  "name": "aftercheck",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --disable-warning=ExperimentalWarning --experimental-strip-types --test test/*.test.mjs",
    "verify": "npm run typecheck && npm test",
    "cli": "node --disable-warning=ExperimentalWarning --experimental-strip-types bin/aftercheck.mjs",
    "demo": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/demo.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
